# Copia a .env — nunca commitees valores reales.
# T0 funciona sin llenar nada (todo es opcional hasta T2/T8/T9).

# --- App ---
ENV=local
COMPANY_ID=company_001
TZ=America/Mexico_City

# --- Backend ---
API_PORT=8000

# --- Frontend (también puedes exportarla en tu shell) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase cloud (se usa en T2). Dónde obtenerlas: ---
# https://supabase.com -> New Project -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (T8 agents). Dónde: ---
# https://platform.openai.com -> API Keys -> Create new secret key
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# --- Gemini (T-tickets: Vision + Browser Agent, SOLO ese flujo). Dónde: ---
# https://aistudio.google.com/apikey. Vacío = ese flujo sigue en OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Email (T9 cobranza). Dónde: ---
# https://resend.com -> API Keys. MAIL_PROVIDER=log registra sin enviar.
# Para envío real: dominio verificado en Resend -> Domains -> DNS.
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=
